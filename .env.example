# ============================================================
# Aegis-Swarm Configuration
# ============================================================

# NVIDIA NIM API (get your key on build.nvidia.com)
NVIDIA_API_KEY=nvapi-your-key-here
NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NIM_MODEL=nvidia/llama-3.1-nemotron-70b-instruct

# NeMo Guardrails Configuration
NEMO_CONFIG_PATH=config/guardrails

# Operational Modes
# Set MOCK_MODE=True to run simulations offline without NVIDIA API credits
MOCK_MODE=False

# Timeouts (in seconds)
# In demo/hackathon mode: 30s. In prod: 300s.
HITL_TIMEOUT_SECONDS=30
STEP_DELAY_SECONDS=2.0
